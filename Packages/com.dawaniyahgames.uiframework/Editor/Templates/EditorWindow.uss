/* Title styling */
.title {
    -unity-font-style: bold;
    font-size: 16px;
    margin-bottom: 8px;
    color: #ffffff;
}

/* Scrollable list area */
#StateList {
    flex-grow: 1;
    background-color: #1e1e1e;
    padding: 5px;
    border-top-width: 1px;
    border-top-color: #444;
    border-bottom-width: 1px;
    border-bottom-color: #444;
}

/* Generic button row */
.button-row {
    flex-direction: row;
    justify-content: flex-start;
    margin-top: 10px;
}

.button-row > * {
    margin-right: 8px;
}

/* Bottom row for actions */
.bottom-row {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 10px;
}

/* Config text field container */
.config-box {
    flex-direction: column;
    margin-bottom: 10px;
}

.config-box > * {
    margin-bottom: 4px;
}

/* Error label style */
.ui-error {
    color: red;
    font-size: 13px;
    -unity-font-style: italic;
}
