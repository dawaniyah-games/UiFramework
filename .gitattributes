# Normalize line endings: LF in the repository, native in working copies
* text=auto

# Shell scripts stay LF everywhere: bash fails on CRLF, also in Git Bash on Windows.
*.sh text eol=lf

*.apk filter=lfs diff=lfs merge=lfs -text
Assets/Firebase/Plugins/x86_64/*.bundle filter=lfs diff=lfs merge=lfs -text
Assets/Firebase/Plugins/x86_64/*.so filter=lfs diff=lfs merge=lfs -text
